---
import Layout from '../../layouts/Layout.astro';
import { getPost } from '../../lib/db';
import { postImage } from '../../lib/images';
import { formatDate } from '../../lib/posts';
import { paragraphs } from '../../lib/text';
import { site } from '../../data/site';

const { id } = Astro.params;
const db = Astro.locals.runtime?.env?.DB;
const found = db && id ? await getPost(db, id) : null;
if (found?.role === 'club') return Astro.redirect(`/bai-viet/clb/${found.id}/`);
const post = found?.role === 'business' ? found : null;
if (!post) Astro.response.status = 404;
const html = post ? paragraphs(post.body) : '';
const image = post ? postImage(post.imageKey, post.updatedAt) : null;
---

<Layout title={post?.title ?? 'Không thấy bài'} description={post?.description ?? 'Bài doanh nghiệp này không có trên DEIC.'}>
  {
    post ? (
      <article class="wrap article">
        <script
          type="application/ld+json"
          set:html={JSON.stringify({
            '@context': 'https://schema.org',
            '@type': 'BlogPosting',
            headline: post.title,
            dateModified: post.updatedAt,
            description: post.description,
            author: { '@type': 'Organization', name: post.businessName },
            mainEntityOfPage: new URL(Astro.url.pathname, site.url).href,
            inLanguage: 'vi',
          })}
        />
        <header>
          <p class="kicker">{post.businessName}</p>
          <h1>{post.title}</h1>
          <p class="deck">{post.description}</p>
          <p class="meta">Cập nhật {formatDate(new Date(post.updatedAt))}</p>
        </header>
        {image && (
          <figure class="frame">
            <img src={image} alt={`Ảnh bài của ${post.businessName}`} />
          </figure>
        )}
        <div class="prose" set:html={html} />
        <p class="source">
          Bài do doanh nghiệp tự đăng. <a href="/doanh-nghiep/">Xem bài doanh nghiệp khác</a>
        </p>
      </article>
    ) : (
      <div class="wrap page-title">
        <h1>Không thấy bài này</h1>
        <p class="deck">
          <a href="/doanh-nghiep/">Về danh sách doanh nghiệp</a>
        </p>
      </div>
    )
  }
</Layout>
