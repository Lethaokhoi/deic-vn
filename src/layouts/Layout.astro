---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.clubName}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="vi_VN" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
    <link rel="icon" href="/logo.png?v=2" type="image/png" />
    <meta name="theme-color" content="#0b6fbe" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="page-backdrop" id="nen-trang" aria-hidden="true"></div>
    <a class="skip" href="#noi-dung">Tới nội dung</a>
    <Header />
    <main id="noi-dung">
      <slot />
    </main>
    <Footer />
    <script>
      const backdrop = document.getElementById('nen-trang');
      const header = document.querySelector('.site-header');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (backdrop && header && !reduce) {
        let ticking = false;
        const update = () => {
          const y = window.scrollY;
          const fade = Math.min(y / 420, 1);
          backdrop.style.opacity = String(1 - fade);
          backdrop.style.transform = `translate3d(0, ${(-y * 0.15).toFixed(1)}px, 0)`;
          const top = 0.34 + fade * 0.66;
          const bottom = 0.22 + fade * 0.78;
          header.style.background = `linear-gradient(180deg, rgba(10, 103, 179, ${top}), rgba(26, 143, 224, ${bottom}))`;
          ticking = false;
        };
        update();
        window.addEventListener(
          'scroll',
          () => {
            if (!ticking) {
              ticking = true;
              requestAnimationFrame(update);
            }
          },
          { passive: true },
        );
      }
    </script>
  </body>
</html>
